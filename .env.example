# Both websites share the portal API and its response/dashboard databases.
# For the initial dev comparison use https://bc-portal-dev.tanuh.ai.
# Before production rollout select the stable shared backend origin.
PORTAL_API_ORIGIN=https://bc-portal-dev.tanuh.ai
# Leave empty to load the database's active questionnaire version.
VITE_QUESTIONNAIRE_VERSION=
# Same immutable frontend image deployed by bcd_portal, with public-only routing.
SHARED_FRONTEND_IMAGE=asia-south1-docker.pkg.dev/bcd-prototypes/bcd-portal/frontend:REPLACE_WITH_TESTED_PORTAL_COMMIT
