{
  "name": "pinkshieldai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node -e \"if(process.env.SKIP_FETCH !== '1'){ console.log('Fetching questionnaire...'); } else { console.log('Skipping DB fetch during build (SKIP_FETCH=1)'); }\"",
    "build": "vite build && node scripts/obfuscate.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "schema:export": "node mysql_explorer/export_schema_csv.js",
    "fetch:questionnaire": "echo 'scripts/fetch_questionnaire.js not found'",
    "test:smoke": "playwright test"
  },
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "^1.11.1",
    "dotenv": "^16.4.5",
    "html2canvas": "^1.4.1",
    "i18next": "^25.6.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.546.0",
    "mixpanel-browser": "^2.77.0",
    "mysql2": "^3.11.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^16.2.2",
    "react-router-dom": "^7.13.2",
    "recharts": "^3.8.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "javascript-obfuscator": "^5.4.3",
    "vite": "npm:rolldown-vite@7.1.14",
    "vite-plugin-pwa": "^1.3.0"
